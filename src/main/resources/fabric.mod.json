{
  "schemaVersion": 1,
  "id": "travelers-journal",
  "version": "${version}",
  "name": "Traveler's Journal",
  "description": "A Minecraft mod that adds a server-wide journal, perfect for server lore, rules, or information sharing.",
  "authors": [
    "gbti-network"
  ],
  "contributors": [
    "DrarkaDev",
    "atwellpub"
  ],
  "contact": {
    "homepage": "https://gbti.network/projects/travelers-journal/",
    "sources": "https://github.com/gbti-network/minecraft-mod-travelers-journal"
  },
  "license": "GPL-3.0",
  "icon": "assets/travelers_journal/icon.png",
  "environment": "server",
  "entrypoints": {
    "main": [
      "com.gbti.TravelersJournal"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.5",
    "minecraft": "${mc_range}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
